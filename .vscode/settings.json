{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "tailwindCSS.classAttributes": ["class", "className", "contentContainerClassName"],
  "tailwindCSS.experimental.classRegex": [["styles = \\{([^}]*)\\}", "'([^']*)'"]]
}
